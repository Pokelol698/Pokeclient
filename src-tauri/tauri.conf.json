{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Poke Client",
  "version": "0.1.0",
  "identifier": "gg.pokeclient.launcher",
  "build": {
    "frontendDist": "../"
  },
  "app": {
    "windows": [
      {
        "title": "Poke Client",
        "width": 1200,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg", "deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/256x256.png", "icons/icon.ico"]
  }
}
